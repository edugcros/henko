{
  "type": "module",
  "name": "ecommerce",
  "version": "1.0.0",
  "engines": {
    "node": "24.21.0"
  },
  "description": "Backend for E-commerce",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "start": "node server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "start:dev": "cross-env NODE_ENV=development node server.js",
    "check:env:dev": "cross-env NODE_ENV=development node src/scripts/checkEnv.js",
    "check:env:prod": "cross-env NODE_ENV=production node src/scripts/checkEnv.js",
    "migrate:catalog-variants": "cross-env NODE_ENV=development node src/scripts/backfillCatalogVariantTemplates.js",
    "migrate:catalog-variants:prod": "cross-env NODE_ENV=production node src/scripts/backfillCatalogVariantTemplates.js",
    "migrate:ai-agent-secrets": "cross-env NODE_ENV=development node src/scripts/migrateAiAgentSecrets.js",
    "migrate:ai-agent-secrets:apply": "cross-env NODE_ENV=development node src/scripts/migrateAiAgentSecrets.js --apply",
    "migrate:ai-agent-secrets:prod": "cross-env NODE_ENV=production node src/scripts/migrateAiAgentSecrets.js --apply",
    "migrate:tenant-secrets": "cross-env NODE_ENV=development node src/scripts/migrateTenantSecrets.js",
    "migrate:tenant-secrets:apply": "cross-env NODE_ENV=development node src/scripts/migrateTenantSecrets.js --apply",
    "migrate:tenant-secrets:prod": "cross-env NODE_ENV=production node src/scripts/migrateTenantSecrets.js --apply",
    "lint": "eslint . --ext .js",
    "fix": "eslint . --ext .js --fix",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "migrate:ledger-unit": "cross-env NODE_ENV=development node src/scripts/backfillLedgerUnit.js",
    "migrate:ledger-unit:apply": "cross-env NODE_ENV=development node src/scripts/backfillLedgerUnit.js --apply",
    "migrate:ledger-unit:prod": "cross-env NODE_ENV=production node src/scripts/backfillLedgerUnit.js --apply",
    "migrate:lead-conversations": "cross-env NODE_ENV=development node src/scripts/backfillLeadConversations.js",
    "migrate:lead-conversations:apply": "cross-env NODE_ENV=development node src/scripts/backfillLeadConversations.js --apply",
    "migrate:lead-conversations:prod": "cross-env NODE_ENV=production node src/scripts/backfillLeadConversations.js --apply",
    "migrate:agent-self-limits": "cross-env NODE_ENV=development node src/scripts/resetAgentSelfLimitDefaults.js",
    "migrate:agent-self-limits:apply": "cross-env NODE_ENV=development node src/scripts/resetAgentSelfLimitDefaults.js --apply",
    "migrate:agent-self-limits:prod": "cross-env NODE_ENV=production node src/scripts/resetAgentSelfLimitDefaults.js --apply",
    "prune:ai-ledger": "cross-env NODE_ENV=development node src/scripts/pruneAiLedger.js",
    "prune:ai-ledger:prod": "cross-env NODE_ENV=production node src/scripts/pruneAiLedger.js"
  },
  "jest": {
    "testTimeout": 30000
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.0",
    "mongodb": "^7.6.0",
    "mongoose": "^6.13.11",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "onnxruntime-node": "^1.29.0",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "slugify": "^1.6.5",
    "uuid": "^14.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/node": "^8.0.1",
    "@babel/plugin-transform-optional-chaining": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.6",
    "process": "^0.11.10",
    "supertest": "^7.1.0"
  },
  "overrides": {
    "uuid": "^14.0.1",
    "qs": "^6.16.0"
  }
}
