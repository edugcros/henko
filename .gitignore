# ============================================
# GLOBAL IGNORE — E-COMMERCE MONOREPO
# ============================================

# Build outputs
dist/
build/

admin/dist/
admin/build/
website/dist/
website/build/

# --- Node.js ---
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# --- Builds Frontend/Backend ---
**/dist/
**/build/
**/coverage/
**/.next/
**/.vite/
**/.turbo/


# --- IA / ML ---
**/.cache/
**/.cache/huggingface/
**/checkpoints/
**/runs/
**/wandb/
**/logs/
*.ckpt
*.pth
*.pt
*.h5
*.tflite
*.joblib
*.onnx

# --- Environment ---
**/.env
**/.env.*
**/*.env.local
**/*.env.development
**/*.env.production
**/sendgrid.env

# --- Secrets / local operational artifacts ---
**/*service-account*.json
**/ga-service.json
**/cookies.txt
**/*.pem
**/*.key
**/*.p12
**/*.zip

# --- VSCode / OS ---
# Del editor se versiona SOLO settings.json, que es lo que hace que todos
# formateen igual. El resto —launch.json personal, estado de la UI— sigue
# afuera. Tiene que ser `.vscode/*` y no `.vscode/`: git no puede desexcluir
# un archivo si el directorio entero está excluido.
.vscode/*
!.vscode/settings.json
*.code-workspace
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp

# --- Scripts ---
run_dev.sh
run_prod.sh
.vercel
.env*
